/* Same palette as config/quickshell/core/Theme.qml: Nord accents reground onto
 * black, so rofi reads as the bar having grown a window rather than as a
 * separate application. */
* {
    bg0:                #0A0A0CF2;
    bg1:                #1A1A20FF;
    bg2:                #88C0D026;

    fg0:                #E8E8EC;
    fg1:                #88C0D0;
    fg2:                #70707C;

    background-color:   transparent;
    text-color:         @fg0;

    margin:             2;
    padding:            2;
    spacing:            2;
}

window {
    background-color:   @bg0;
    location:           center;
    width:              640;
    border-radius:      24;
}

inputbar {
    padding:    12px;
    spacing:    12px;
}


icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    placeholder         : "Search";
    placeholder-color   : @fg2;
}

message {
    border:             2px 0 0;
    border-color:       @bg1;
    background-color:   @bg1;
}

textbox {
    padding:    8px 24px;
}

listview {
    lines:          10;
    columns:        1;
    fixed-height:   false;
    border:         1px 0 0;
    border-color:   @bg1;
}

element {
    padding:            8px 16px;
    spacing:            16px;
    background-color:   transparent;
}

element normal active {
    text-color: @fg1;
}

element alternate active {
    text-color: @fg1;
}

element selected normal, element selected active {
    background-color:   @bg2;
    text-color:         @fg1;
    border-radius:      8px;
}

element-icon {
    size:   1em;
}

element-text {
    text-color: inherit;
}
