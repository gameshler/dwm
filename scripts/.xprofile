#!/bin/sh
# Session environment for dwm, sourced by display managers and by
# scripts/.xinitrc so both session paths get the same environment.

# Qt has no theme of its own in a bare X session and defaults to its light
# Fusion palette. gtk3 inherits the GTK theme and icon theme wholesale;
# xdgdesktopportal reads the color-scheme key install.sh sets; gnome is the
# last resort and resolves icons but not the palette.
if [ -z "${QT_QPA_PLATFORMTHEME:-}" ]; then
	QT_QPA_PLATFORMTHEME=gnome
	for qt_dir in /usr/lib/qt6/plugins/platformthemes \
		/usr/lib/qt/plugins/platformthemes; do
		if [ -e "$qt_dir/libqgtk3.so" ]; then
			QT_QPA_PLATFORMTHEME=gtk3
			break
		elif [ -e "$qt_dir/libqxdgdesktopportal.so" ]; then
			QT_QPA_PLATFORMTHEME=xdgdesktopportal
			break
		fi
	done
	unset qt_dir
	export QT_QPA_PLATFORMTHEME
fi

[ -n "${XCURSOR_THEME:-}" ] || export XCURSOR_THEME=Adwaita
[ -n "${XCURSOR_SIZE:-}" ] || export XCURSOR_SIZE=24

# ~/.Xresources holds Xft.dpi, and nothing else in this session loads it: a
# custom ~/.xinitrc replaces /etc/X11/xinit/xinitrc wholesale rather than adding
# to it. Merged, not loaded, so a display manager that already read it keeps its
# work.
if [ -r "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1; then
	xrdb -merge "$HOME/.Xresources"
fi
